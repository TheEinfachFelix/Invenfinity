{
    "version": 1,
    "requirements": {
        "minWidthPerPart": 1,
        "AssetType": "Line"
    },
    "Layout": [
        {
            "type": "partElement",
            "padding": 1
        }
    ],
    "partElement": [
        {
            "type": "stack",
            "horisontalAlign": "Right",
            "Top": [
                {
                    "type": "image",
                    "value": "head",
                    "padding": 1,
                    "minScale": 1,
                    "verticalAlign": "Center"
                },
                {
                    "type": "image",
                    "value": "side",
                    "padding": 1,
                    "minScale": 1,
                    "orientation": "Wide",
                    "verticalAlign": "Center"
                }
            ],
            "Bottom": [
                {
                    "type": "text",
                    "value": "*{Thread}*x{Length}",
                    "maxScale": 1.1,
                    "padding": 0.5,
                    "verticalAlign": "Bottom"
                }
            ]
        },
        {
            "type": "qrcode",
            "value": "{Id}",
            "minScale": 1,
            "padding": 1,
            "verticalAlign": "Center",
            "horisontalAlign": "Right"
        }
    ]
}
{
    "version": 1,
    "requirements": {
        "minWidthPerPart": 1,
        "AssetType": "Line"
    },
    "Layout": [
        {
            "type": "partElement",
            "padding": 1
        }
    ],
    "partElement": [
        {
            "type": "stack",
            "maxScale": 8,
            "horisontalAlign": "Right",
            "Top": [
                {
                    "type": "groupe",
                    "horisontalAlign": "Center",
                    "orientation": "Wide",
                    "maxScale": 8,
                    "elements": [
                        {
                            "type": "image",
                            "value": "head",
                            "padding": 1,
                            "maxScale": 8,
                            "minScale": 0.9,
                            "horisontalAlign": "Right"
                        },
                        {
                            "type": "image",
                            "value": "side",
                            "padding": 1,
                            "minScale": 0.9,
                            "maxScale": 8,
                            "orientation": "Wide",
                            "horisontalAlign": "Left"
                        }
                    ]
                }
            ],
            "Bottom": [
                {
                    "type": "text",
                    "value": "*{Thread}*x{Length}",
                    "maxScale": 8,
                    "padding": 0.5,
                    "horisontalAlign": "Center"
                }
            ]
        },
        {
            "type": "qrcode",
            "value": "{Id}",
            "minScale": 1,
            "verticalAlign": "Center",
            "horisontalAlign": "Right"
        }
    ]
}